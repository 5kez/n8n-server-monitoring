    {
      "parameters": {
        "jsCode": "return $json.stdout\n  .split('\\n')\n  .filter(Boolean)\n  .map(p => {\n    const parts = p.split('/');\n    return {\n      json: {\n        path: p,\n        app: parts[4],\n        table: parts[5],\n        type: parts[6],\n        year: parts[7],\n        month: parts[8],\n        filename: parts[9]\n      }\n    };\n  });\n"
      },
